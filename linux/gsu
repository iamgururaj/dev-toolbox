#!/bin/bash
source "$(dirname "$0")/log_info.sh"
# gsu.sh - set upstream to origin/<current-branch>

set -euo pipefail

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Not inside a git repository."
  exit 1
fi

branch="$(git branch --show-current)"

if [[ -z "$branch" ]]; then
  echo "You are not on a branch. Switch to a branch before running this command."
  exit 1
fi

log_run git branch --set-upstream-to="origin/$branch" "$branch"